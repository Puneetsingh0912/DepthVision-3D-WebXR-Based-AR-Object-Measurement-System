# Copy this file to .env and fill in your MongoDB Atlas connection string.
# NEVER put this URI in index.html or any GitHub Pages frontend file.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/ar_measurements?retryWrites=true&w=majority
PORT=8080
# Comma-separated allowed frontend origins. Example: https://YOUR-USERNAME.github.io
# For local testing, include http://localhost:5500
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io,http://localhost:5500
